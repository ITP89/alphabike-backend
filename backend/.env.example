DB_URL=jdbc:postgresql://localhost:5432/alphabike
DB_USERNAME=alphabike
DB_PASSWORD=replace-with-your-local-password
JWT_SECRET=replace-with-a-random-private-secret-at-least-32-bytes
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_FRONTEND_URL=http://localhost:5173
# Development seed only. Set a private password before enabling.
APP_SEED_ADMIN_ENABLED=false
APP_SEED_ADMIN_PASSWORD=

# MongoDB (required for the SQL + NoSQL delivery)
MONGODB_URI=mongodb://localhost:27017/alphabike?serverSelectionTimeoutMS=2000&connectTimeoutMS=2000&socketTimeoutMS=3000
HISTORIAL_ENABLED=true
